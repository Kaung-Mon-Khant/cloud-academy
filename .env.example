# ── Copy to .env and change the secrets before running in production ──

# PostgreSQL (used by docker compose and the API)
POSTGRES_USER=cloudacademy
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=cloudacademy
DATABASE_URL=postgresql://cloudacademy:change-me-strong-password@localhost:5432/cloudacademy?schema=public

# API
NODE_ENV=development
API_PORT=4000
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Comma-separated list of allowed browser origins (dev only; in Docker the web proxy is same-origin)
CORS_ORIGINS=http://localhost:5173
# Set to true only when the site is served over HTTPS
COOKIE_SECURE=false

# Web (docker compose published port)
WEB_PORT=80
