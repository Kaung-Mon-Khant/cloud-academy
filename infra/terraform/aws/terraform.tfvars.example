# cp terraform.tfvars.example terraform.tfvars  (terraform.tfvars is git-ignored)
region              = "ap-northeast-1"
instance_type       = "t3.small"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"
allowed_ssh_cidr    = "203.0.113.10/32" # ← your IP: curl -s https://checkip.amazonaws.com
repo_url            = "https://github.com/Kaung-Mon-Khant/cloud-academy.git"
repo_ref            = "main"

# Route 53 + HTTPS (optional). Leave hosted_zone empty for plain http://<ip>/
hosted_zone = "" # e.g. "kaung-cloud.com" — must exist in Route 53 → Hosted zones
subdomain   = "" # e.g. "academy" → https://academy.kaung-cloud.com
