# HTTPS reverse proxy in front of the web (nginx) container.
# Caddy gets and renews a Let's Encrypt certificate for $DOMAIN automatically,
# and redirects http:// → https://. DNS for $DOMAIN must point at this server.
{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy web:80
}
